// Enhanced response limits for all avatars (system-wide improvements)
const FAST_MAX_TOKENS_DEMO = 200;  // increased for complete demo responses
const FAST_MAX_TOKENS_NORMAL = 150; // increased for all avatars to allow complete thoughts
const FAST_MAX_MS_DEMO = 3000;     // increased for demo mode to ensure complete responses
const FAST_MAX_MS_NORMAL = 2000;   // increased for all avatars to allow complete responses
const FAST_MAX_SENTS = 12;         // increased for all avatars to allow complete thoughts and stories

// Helper functions
function fastHelloFromCacheOrTemplate({ name }: { name: string }) {
  // Deterministic, friendly, model-free opener; keep < 120 chars
  return `Hey there—it's ${name}. What's on your mind?`;
}

// Get pinned memories for fast path political/opinion queries
async function getPinnedMemoriesForFastPath(query: string, avatarId: string) {
  try {
    const { data, error } = await supabase.rpc('get_enhanced_memories', {
      target_user_id: null,
      target_avatar_id: avatarId,
      search_query: query,
      match_count: 10,
      similarity_threshold: 0.25,
      include_bio_facts: true
    });

    if (error || !data) {
      return [];
    }

    // Filter for political/opinion content
    const candidates = data.filter((memory: any) => {
      const ctx = memory.conversation_context || {};
      const text = memory.fragment_text.toLowerCase();
      
      // Include if context type is opinion or language_style
      if (ctx.type === 'opinion' || ctx.type === 'language_style') {
        return true;
      }
      
      // Include if fragment contains Trump content
      if (text.includes('trump')) {
        return true;
      }
      
      // Include if context contains politics
      if (ctx.context && ctx.context.includes('politics')) {
        return true;
      }
      
      return false;
    });

    // Boost scores and return top 3
    const boosted = candidates.map((memory: any) => {
      const ctx = memory.conversation_context || {};
      let boost = 0;
      
      if (ctx.type === 'opinion' || (ctx.context && ctx.context.includes('politics'))) {
        boost = 0.4;
      }
      
      return {
        ...memory,
        similarity_score: Math.min(1.0, (memory.similarity_score || 0.8) + boost)
      };
    });

    return boosted
      .sort((a: any, b: any) => b.similarity_score - a.similarity_score)
      .slice(0, 3);
      
  } catch (error) {
    console.warn('Failed to get pinned memories for fast path:', error);
    return [];
  }
}

